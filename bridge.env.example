# 复制为 bridge.env 并填写。只放密钥，不要提交真实值，权限 0600。
# Arr 的变量名对应 config.yml 里 arr 下的名字：<NAME>_API_KEY（非字母数字换成下划线并转大写）。

# WebUI 密码（Arr 添加下载客户端时填写，用户名在 config.yml 的 webui.username）
WEBUI_PASSWORD=

# Arr 的 API Key（用于失败回退时调用 Arr）
RADARR_API_KEY=
SONARR_API_KEY=

# Telegram 推送（可选；两个要么都填要么都不填）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 代理（可选）。若为访问 Telegram 设置了代理：
#   HTTPS_PROXY=http://proxy.example:7890
# 必须同时设置 NO_PROXY，包含局域网地址与 127.0.0.1，避免本机与局域网流量被送进代理：
#   NO_PROXY=127.0.0.1,localhost,<你的局域网 CIDR>
# 注意 CDN 下载也会读取环境代理。
